static func callout_at(p: Vector3) -> String:
	var c := int(floor((p.x - ORIGIN) / CELL))
	var r := int(floor((p.z - ORIGIN) / CELL))
	if r < 0 or c < 0 or r >= CALLOUT_GRID.size() or c >= CALLOUT_GRID[0].size():
		return ""
	return CALLOUT_NAMES[CALLOUT_GRID[r][c]]
